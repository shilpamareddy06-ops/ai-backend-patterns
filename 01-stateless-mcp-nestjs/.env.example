# The app does not read .env itself. Use: node --env-file=.env dist/src/main.js
PORT=3000
# Interface to bind. 127.0.0.1 is the safe default; use 0.0.0.0 in a container behind a load balancer.
HOST=127.0.0.1
# SQLite file shared by every instance that should see the same baskets
DB_PATH=./data/baskets.db
# Accepted Host / Origin header hostnames (no port, no scheme), comma-separated. Setting them replaces the
# localhost defaults (localhost,127.0.0.1,[::1]); anything else gets HTTP 403. Example for a public deployment:
# ALLOWED_HOSTS=mcp.example.com
# ALLOWED_ORIGINS=app.example.com
